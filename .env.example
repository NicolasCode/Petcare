# Cadena de conexión a PostgreSQL 16 (en Railway se inyecta automáticamente al enlazar el plugin)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kurapet
# Secreto para firmar los tokens de sesión. Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo
PORT=3000
NODE_ENV=development
# Correos (separados por coma) con permisos de administrador para gestionar el directorio de clínicas
ADMIN_EMAILS=tu-correo@ejemplo.com
