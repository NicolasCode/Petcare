# Cadena de conexión a PostgreSQL 16 (en Railway se inyecta automáticamente al enlazar el plugin)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kaimi
# Secreto para firmar los tokens de sesión. Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo
PORT=3000
NODE_ENV=development
# Correos (separados por coma) con permisos de administrador para gestionar el directorio de clínicas
ADMIN_EMAILS=tu-correo@ejemplo.com
# true = carga/reinicia una cuenta demo (demo@kaimi.co) con mascotas e historia clínica al arrancar
SEED_DEMO=false
# Contraseña de la cuenta demo (por defecto: kaimi-demo)
DEMO_PASSWORD=
# URL pública de la app para los enlaces de los correos (en Railway se usa RAILWAY_PUBLIC_DOMAIN si falta)
APP_URL=
# Correo transaccional con Resend (verificación, recuperar contraseña, recordatorios). Sin clave, se escriben en el log
RESEND_API_KEY=
MAIL_FROM=Kaimi <no-responder@tu-dominio.co>
# Notificaciones push. Genera las claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@kaimi.co
# Recordatorios por WhatsApp para clínicas Pro (Cloud API de Meta). La plantilla debe estar aprobada y recibir,
# en orden: nombre del dueño, mascota, cuidado, fecha y clínica
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=recordatorio_cuidado
WHATSAPP_TEMPLATE_LANG=es
