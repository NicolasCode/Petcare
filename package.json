{
  "name": "kaimi",
  "private": true,
  "version": "1.0.0",
  "description": "Kaimi: la historia clínica y el cuidado de tu mascota en un solo lugar",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "migrate": "npm run migrate --workspace server",
    "seed:demo": "npm run seed:demo --workspace server",
    "test": "npm test --workspace server"
  }
}
